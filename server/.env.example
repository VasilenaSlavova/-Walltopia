# Copy to .env and fill in. .env is gitignored — never commit real secrets.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
DB_NAME=walltopia
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
PORT=8787
CORS_ORIGIN=
NODE_ENV=development
# If a "mongodb+srv" connection fails with querySrv/ECONNREFUSED (a DNS problem), force
# public DNS for the SRV lookup. Leave blank to use your OS resolver (with an auto public-DNS retry).
DNS_SERVERS=

# Engineering Support email delivery. For Microsoft 365 SMTP use port 587,
# SMTP_SECURE=false and an account/app password permitted to use SMTP AUTH.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ENGINEERING_SUPPORT_EMAIL=

# Recommended alternative to SMTP for prototypes and production.
# Create a key at https://resend.com/api-keys. With the Resend test domain,
# the recipient must be the email address associated with your Resend account.
RESEND_API_KEY=
RESEND_FROM=Walltopia Engineering Support <onboarding@resend.dev>
